# =============================================================================
# CloudDB Sentinel — Variables de Entorno y Configuración
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de Datos Cliente A: PostgreSQL 16 (B2B Telecom & CRM)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cliente_a_prod
POSTGRES_USER=admin_cloud
POSTGRES_PASSWORD=SecureCloudPass2026!
POSTGRES_MAX_CONNECTIONS=100

# -----------------------------------------------------------------------------
# 2. Base de Datos Cliente B: MySQL 8.0 (B2B Facturación & Servicios)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=cliente_b_prod
MYSQL_USER=admin_mysql
MYSQL_PASSWORD=MySQLPass2026!
MYSQL_ROOT_PASSWORD=RootSecurePass2026!

# -----------------------------------------------------------------------------
# 3. Almacenamiento de Respaldos (AWS S3 / MinIO Local)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=cloud_backup_admin
S3_SECRET_KEY=MinioBackupPass2026!
S3_BUCKET_NAME=clouddb-backups-b2b
S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=zstd   # opciones: zstd, gzip

# -----------------------------------------------------------------------------
# 4. Observabilidad & Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminGrafana2026!

# -----------------------------------------------------------------------------
# 5. Sistema de Alertas & Notificaciones (Telegram / ITSM Tickets)
# -----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

ITSM_WEBHOOK_ENABLED=false
ITSM_WEBHOOK_URL=http://localhost:8080/api/v1/tickets/webhook
ALERT_COOLDOWN_MINUTES=30

# -----------------------------------------------------------------------------
# 6. Umbrales de Capacidad (Capacity Planning)
# -----------------------------------------------------------------------------
DISK_WARNING_THRESHOLD_PERCENT=75
DISK_CRITICAL_THRESHOLD_PERCENT=90
CAPACITY_GROWTH_WINDOW_DAYS=30
ESTIMATED_MAX_CAPACITY_GB=500

# -----------------------------------------------------------------------------
# 7. Rutas Locales del Sistema
# -----------------------------------------------------------------------------
LOCAL_BACKUP_DIR=./data/backups
LOG_DIR=./logs
REPORTS_DIR=./reports
DATA_DIR=./data
